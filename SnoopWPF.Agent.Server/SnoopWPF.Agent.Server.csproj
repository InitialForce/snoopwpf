<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <UseWpf>true</UseWpf>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <!-- CA1063/CA1816: IDisposable pattern used intentionally -->
        <NoWarn>$(NoWarn);CA1063;CA1816</NoWarn>
    </PropertyGroup>

    <!-- Expose internals (SelfTest, SelfTestTarget) to integration test project -->
    <!-- Expose internals (SnoopAgentHandle ctor, SnoopAgent.ClearHandle) to unit test project -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>SnoopWPF.Agent.IntegrationTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- NuGet package metadata -->
    <PropertyGroup>
        <PackageId>SnoopWPF.Agent</PackageId>
        <Description>MCP server for WPF runtime inspection via SnoopWPF. Exposes visual tree, properties, triggers, behaviors, and screenshots as MCP tools for AI-assisted debugging.</Description>
        <Authors>Cory Plotts, Bastian Schmidt, and contributors</Authors>
        <PackageTags>wpf;mcp;snoop;agent;inspector;claude;ai;debug;visualtree</PackageTags>
        <PackageLicenseFile>License.txt</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>snoop.png</PackageIcon>
        <PackageProjectUrl>https://github.com/InitialForce/snoopwpf</PackageProjectUrl>
        <RepositoryUrl>https://github.com/InitialForce/snoopwpf</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- NuGet pack: include license, readme, and icon from repo root -->
    <ItemGroup>
        <None Include="../License.txt" Pack="true" PackagePath="/" />
        <None Include="../README.md" Pack="true" PackagePath="/" Condition="Exists('../README.md')" />
        <None Include="../Artwork/snoop.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Flatten Engine, Tools, and Contracts DLLs into lib/ instead of listing as deps -->
    <ItemGroup>
        <!-- M1-16: Ship SWPF0001 analyzer with the server NuGet so consumers get it automatically -->
        <ProjectReference Include="../SnoopWPF.Agent.Analyzers/SnoopWPF.Agent.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="../SnoopWPF.Agent.Contracts/SnoopWPF.Agent.Contracts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../SnoopWPF.Agent.Engine/SnoopWPF.Agent.Engine.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../SnoopWPF.Agent.Tools/SnoopWPF.Agent.Tools.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <!-- StartBrokeredClient reuses PipeAgentServer (public) for the target-as-pipe-client
             dispatch loop. Injection multitargets net462/net6.0-windows/net8.0-windows;
             MSBuild picks net8.0-windows as the compatible TFM for Server. -->
        <ProjectReference Include="../SnoopWPF.Agent.Injection/SnoopWPF.Agent.Injection.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

</Project>
