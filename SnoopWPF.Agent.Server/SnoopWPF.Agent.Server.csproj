<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <UseWpf>true</UseWpf>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <!-- CA1063/CA1816: IDisposable pattern used intentionally -->
        <NoWarn>$(NoWarn);CA1063;CA1816</NoWarn>
    </PropertyGroup>

    <!-- Expose internals (SelfTest, SelfTestTarget) to integration test project -->
    <!-- Expose internals (SnoopAgentHandle ctor, SnoopAgent.ClearHandle) to unit test project -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>SnoopWPF.Agent.IntegrationTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- NuGet package metadata -->
    <PropertyGroup>
        <PackageId>InitialForce.SnoopAgent</PackageId>
        <Description>MCP server agent for inspecting and automating WPF applications. Exposes 29 tools for AI coding agents (Claude Code, etc.). This is the primary package — it bundles Engine, Tools, Contracts, and Injection assemblies.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>snoop.png</PackageIcon>
    </PropertyGroup>

    <!-- NuGet pack: include license, per-package readme, and icon -->
    <ItemGroup>
        <None Include="../License.txt" Pack="true" PackagePath="/" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../Artwork/snoop.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Flatten Engine, Tools, and Contracts DLLs into lib/ instead of listing as deps -->
    <ItemGroup>
        <!-- M1-16: Ship SWPF0001 analyzer with the server NuGet so consumers get it automatically -->
        <ProjectReference Include="../SnoopWPF.Agent.Analyzers/SnoopWPF.Agent.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="../SnoopWPF.Agent.Contracts/SnoopWPF.Agent.Contracts.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../SnoopWPF.Agent.Engine/SnoopWPF.Agent.Engine.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="../SnoopWPF.Agent.Tools/SnoopWPF.Agent.Tools.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <!-- StartBrokeredClient reuses PipeAgentServer (public) for the target-as-pipe-client
             dispatch loop. Injection multitargets net462/net6.0-windows/net8.0-windows;
             MSBuild picks net8.0-windows as the compatible TFM for Server. -->
        <ProjectReference Include="../SnoopWPF.Agent.Injection/SnoopWPF.Agent.Injection.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <!--
        Bundle all referenced-project DLLs into lib/ at pack time.
        The five PrivateAssets=all references (Contracts, Engine, Tools, Injection, Analyzers)
        are not listed as NuGet dependencies; instead their outputs are copied directly into
        the package lib/ folder so consumers get them without an extra NuGet reference.
        Pattern: https://docs.microsoft.com/en-us/nuget/create-packages/set-package-type#custom-pack-targets
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackReferencedProjectOutputs</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <Target Name="PackReferencedProjectOutputs">
        <!-- Collect the output DLL (and PDB) from each PrivateAssets=all ProjectReference.
             $(TargetDir) is the resolved per-TFM output folder, e.g.
             C:\work\snoopwpf\bin\Release\net8.0-windows\.
             Snoop.Core.dll comes in transitively via Engine → Snoop.Core and must ship
             in lib/ alongside the agent DLLs — without it consumers hit
             FileNotFoundException("Snoop.Core") the first time a wpf_* tool fires
             and the Engine code path tries to walk the visual tree. -->
        <ItemGroup>
            <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Contracts.dll" />
            <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Engine.dll" />
            <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Tools.dll" />
            <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Injection.dll" />
            <BuildOutputInPackage Include="$(TargetDir)Snoop.Core.dll" />
        </ItemGroup>
    </Target>

</Project>
