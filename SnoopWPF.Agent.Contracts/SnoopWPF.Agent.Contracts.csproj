<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net6.0-windows;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- WPF required for IDeterministicInputStrategy (DependencyObject), IIdlingResource (DispatcherPriority) -->
    <UseWpf>true</UseWpf>
    <!-- CA1819: PngBytes must be byte[] for pipe serialization; CA1032: SnoopException
         uses richer constructor pattern that satisfies the intent -->
    <NoWarn>$(NoWarn);CA1819;CA1032</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SnoopWPF.Agent.Contracts</PackageId>
    <Description>Shared DTOs, interfaces, and WpfLocator for SnoopWPF Agent. Referenced by both the server (injected side) and remote clients.</Description>
    <Authors>Cory Plotts, Bastian Schmidt, and contributors</Authors>
    <PackageTags>wpf;mcp;snoop;agent;contracts;dto</PackageTags>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>snoop.png</PackageIcon>
    <PackageProjectUrl>https://github.com/InitialForce/snoopwpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InitialForce/snoopwpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- NuGet pack: include license, per-package readme, and icon -->
  <ItemGroup>
    <None Include="../License.txt" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../Artwork/snoop.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Engine</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Server</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
