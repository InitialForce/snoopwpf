<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>$(MinCoreTargetFramework);net472</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- CI runners install only the global.json SDK (.NET 10). The net6.0-windows testhost
       rolls forward onto the installed .NET 10 WindowsDesktop runtime so these tests run
       without a separate .NET 6 runtime install. Ignored for net472 (.NET Framework). -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net472'">
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />

    <PackageReference Include="Verify.NUnit" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snoop.Core\Snoop.Core.csproj" />
  </ItemGroup>
</Project>