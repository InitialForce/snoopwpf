<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- CA1063/CA1816: IDisposable pattern used intentionally -->
    <NoWarn>$(NoWarn);CA1063;CA1816</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>InitialForce.SnoopAgent.BrokerHost</PackageId>
    <Description>Brokered-mode host library for SnoopWPF Agent. Provides the MCP broker infrastructure consumed by external host processes (e.g. UiMcpHost) to communicate with injected WPF agents.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>snoop.png</PackageIcon>
  </PropertyGroup>

  <!-- NuGet pack: include license, per-package readme, and icon -->
  <ItemGroup>
    <None Include="../License.txt" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../Artwork/snoop.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Flatten all referenced-project DLLs into lib/ rather than listing them as
       NuGet dependencies. This mirrors the approach used by SnoopWPF.Agent.Server.
       Consumers install a single package and get all required DLLs without additional
       package references. -->
  <ItemGroup>
    <ProjectReference Include="..\SnoopWPF.Agent.Contracts\SnoopWPF.Agent.Contracts.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SnoopWPF.Agent.Remote\SnoopWPF.Agent.Remote.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SnoopWPF.Agent.Tools\SnoopWPF.Agent.Tools.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <!-- BrokerHost references Engine.BlobStore for broker-local blob caching
         (CaptureScreenshot/FetchBlob). Engine.dll ships in lib/ via
         PackBrokerReferencedProjectOutputs. The architectural invariant is that
         BrokerHost must never instantiate AuditLogWriter (audit is target-only,
         M1-13 / B-5); asserted by BrokerHostTests via IL scan, not by forbidding
         the Engine reference wholesale. -->
    <ProjectReference Include="..\SnoopWPF.Agent.Engine\SnoopWPF.Agent.Engine.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!--
      Bundle all PrivateAssets=all referenced-project DLLs into lib/ at pack time.
      Pattern mirrors SnoopWPF.Agent.Server.csproj (FX6-B2).
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackBrokerReferencedProjectOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="PackBrokerReferencedProjectOutputs">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Contracts.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Remote.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Tools.dll" />
      <BuildOutputInPackage Include="$(TargetDir)SnoopWPF.Agent.Engine.dll" />
      <!-- Engine transitively needs Snoop.Core at runtime; include the DLL in lib/
           so brokers do not hit FileNotFoundException on first visual-tree call. -->
      <BuildOutputInPackage Include="$(TargetDir)Snoop.Core.dll" />
    </ItemGroup>
  </Target>

</Project>
