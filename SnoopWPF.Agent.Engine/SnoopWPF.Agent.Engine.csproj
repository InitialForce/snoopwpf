<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- net462: injected-agent mode (no WGC).
         net6/net8: versioned to Windows 10 19H1 (19041) to enable Windows.Graphics.Capture WinRT APIs
         without extra NuGet packages.  The old unversioned TFMs (net6.0-windows / net8.0-windows)
         did not surface WinRT types — the Windows API version suffix is required. -->
    <TargetFrameworks>net462;net6.0-windows10.0.19041.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWpf>true</UseWpf>
    <IsPackable>false</IsPackable>
    <!-- CA1063/CA1816: IDisposable pattern used intentionally -->
    <NoWarn>$(NoWarn);CA1063;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Server</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnoopWPF.Agent.Contracts\SnoopWPF.Agent.Contracts.csproj" />
    <ProjectReference Include="..\Snoop.Core\Snoop.Core.csproj" />
  </ItemGroup>

</Project>
