<Window x:Class="SnoopWPF.Minimal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnoopWPF Minimal Sample"
        Width="400" Height="200">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="SnoopWPF MCP agent is running on stdio."
                   HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,8" />
        <TextBlock Text="Point an MCP client at this process to inspect this window."
                   HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,12" />
        <Button Content="Click me" HorizontalAlignment="Center" Padding="12,4" />
    </StackPanel>
</Window>
