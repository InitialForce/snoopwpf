<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>InitialForce.SnoopAgent.Remote</PackageId>
    <Description>Pipe client and framing library for SnoopWPF Agent brokered mode. Consumed by external brokers to communicate with an injected SnoopWPF Agent over named-pipe transport.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>snoop.png</PackageIcon>
  </PropertyGroup>

  <!-- NuGet pack: include license, per-package readme, and icon -->
  <ItemGroup>
    <None Include="../License.txt" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../Artwork/snoop.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.InjectionTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnoopWPF.Agent.Contracts\SnoopWPF.Agent.Contracts.csproj" />
  </ItemGroup>

</Project>
