<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>SnoopWPF.Agent.Remote</PackageId>
    <Description>Pipe client and framing library for SnoopWPF Agent brokered mode. Consumed by external brokers to communicate with an injected SnoopWPF Agent over named-pipe transport.</Description>
    <Authors>Cory Plotts, Bastian Schmidt, and contributors</Authors>
    <PackageTags>wpf;mcp;snoop;agent;remote;pipe</PackageTags>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/InitialForce/snoopwpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InitialForce/snoopwpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- NuGet pack: include license and readme from repo root -->
  <ItemGroup>
    <None Include="../License.txt" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" Condition="Exists('../README.md')" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SnoopWPF.Agent.InjectionTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnoopWPF.Agent.Contracts\SnoopWPF.Agent.Contracts.csproj" />
  </ItemGroup>

</Project>
